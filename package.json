{
  "name": "ipo-singh",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,api -c auto \"npm run dev -w @ipo-singh/web\" \"npm run dev -w @ipo-singh/api\"",
    "dev:web": "npm run dev -w @ipo-singh/web",
    "dev:api": "npm run dev -w @ipo-singh/api",
    "dev:mobile": "npm run start -w @ipo-singh/mobile",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start -w @ipo-singh/web",
    "start:api": "npm run start -w @ipo-singh/api",
    "start:worker": "npm run start:worker -w @ipo-singh/api",
    "start:cron": "npm run start:cron -w @ipo-singh/api",
    "sync:once": "npm run sync:once -w @ipo-singh/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
