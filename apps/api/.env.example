# IPO Singh API local configuration.
# Copy this file to apps/api/.env. The process environment always wins.
# Production ignores apps/api/.env and reads only the process environment.
# Do not put real secrets in this file.

NODE_ENV=development

# Logical deployment lane for Mongo/Redis key isolation.
# development | staging | production | test
# Staging hosts that run NODE_ENV=production must set IPO_SINGH_DEPLOYMENT=staging
# and use an isolated database name (for example ipo-singh-staging).
# IPO_SINGH_DEPLOYMENT=development

# Bind address. 0.0.0.0 accepts connections inside a container.
HOST=0.0.0.0
PORT=4000

# Comma-separated browser origins. A wildcard is rejected.
# Staging and production require at least one https origin (no Cloudflare quick tunnels).
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=info

# express body limit, for example 100kb or 1mb.
REQUEST_BODY_LIMIT=100kb

# Public request limits per client address. Health and readiness are exempt.
# Search, detail, and auth limits cannot be higher than the catalogue limit.
RATE_LIMIT_WINDOW_MS=60000
# Catalogue default is high enough for Next.js SSR fan-out from one website host IP.
RATE_LIMIT_CATALOGUE=300
RATE_LIMIT_SEARCH=60
RATE_LIMIT_DETAIL=120
RATE_LIMIT_AUTH=10
# Administrator routes (session + dashboard + banners). Cannot exceed the catalogue limit.
RATE_LIMIT_ADMIN=120

# Node HTTP server timeouts. The headers timeout must be greater than the keep-alive timeout.
REQUEST_TIMEOUT_MS=15000
HEADERS_TIMEOUT_MS=10000
KEEP_ALIVE_TIMEOUT_MS=5000

# Time allowed for open connections to finish after SIGTERM or SIGINT.
SHUTDOWN_TIMEOUT_MS=10000

# Set to true only behind a reverse proxy that overwrites X-Forwarded-* headers.
# When true, Express trusts a single hop (app.set("trust proxy", 1)) for rate limits and client IP.
# Do not enable on a process that accepts direct public traffic without a trusted edge.
TRUST_PROXY=false

SERVICE_NAME=ipo-singh-api

# Optional first super admin. Leave both unset to skip. Never commit a real password.
# A public account with this email is not promoted. An existing super admin is left unchanged.
# IPO_SINGH_BOOTSTRAP_ADMIN_EMAIL=
# IPO_SINGH_BOOTSTRAP_ADMIN_PASSWORD=

# Protects GET /internal/status. 16 to 128 characters. Do not commit a real token.
# Leave unset to keep the operational status route dark.
# OPS_TOKEN=

# Shared secret for the Next.js website → API hop (SSR and /api/admin BFF).
# Send as header x-ipo-singh-internal from server-side fetches only. Never EXPO_PUBLIC_ / NEXT_PUBLIC_.
# When set on both sides, catalogue/admin rate limits skip for that hop; auth login budgets stay enforced.
# INTERNAL_SERVICE_TOKEN=

# Local / non-production MongoDB. Database name must include "dev", "test", or "staging"
# and must not contain "prod". Production uses a dedicated URI in the process environment
# (apps/api/.env is ignored when NODE_ENV=production).
# Put credentials in the process environment, never in logs. This example has none.
# MONGODB_URI=mongodb://127.0.0.1:27017/ipo-singh-dev
# Staging example (no credentials):
# MONGODB_URI=mongodb+srv://CLUSTER_HOST/ipo-singh-staging?retryWrites=true&w=majority

MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=0
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=20000

# Optional Redis cache. Leave unset to run without Redis.
# The API keeps serving if Redis is down, and labels last-known-good values as stale.
# Production workers require REDIS_URL. Use a different logical DB index (or instance)
# for development, staging, and production — never point staging at production Redis.
# Put credentials in the process environment, never in logs. This example has none.
# REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT_MS=5000

# Fresh TTLs are application choices, not a provider's update frequency.
# GMP 120 minutes. Subscription 60 minutes while bidding, 30 minutes near close, 24 hours after close.
# IPO directory and issue details stay fresh for 24 hours.
# The directory also refreshes at 08:00 Asia/Kolkata, and can be refreshed manually.
# Listing-day data refreshes at 10:00 Asia/Kolkata, then at the follow-up times.
# History stays cached for 7 days. The registrar directory stays cached for 24 hours.
# Registrar entries still have to be verified before they are treated as official links.
# Stale windows keep the last known value through a provider outage.
CACHE_TTL_GMP_MS=7200000
CACHE_TTL_SUBSCRIPTION_MS=3600000
CACHE_TTL_SUBSCRIPTION_CLOSING_MS=1800000
CACHE_TTL_SUBSCRIPTION_CLOSED_MS=86400000
CACHE_SUBSCRIPTION_CLOSING_LEAD_MS=7200000
CACHE_TTL_LISTINGS_MS=86400000
CACHE_TTL_ISSUE_MS=86400000
CACHE_TTL_HISTORY_MS=604800000
CACHE_TTL_REGISTRAR_MS=86400000
CACHE_TTL_LISTING_MS=86400000
CACHE_STALE_GMP_MS=86400000
CACHE_STALE_SUBSCRIPTION_MS=604800000
CACHE_STALE_LISTINGS_MS=604800000
CACHE_STALE_ISSUE_MS=604800000
CACHE_STALE_HISTORY_MS=2592000000
CACHE_STALE_REGISTRAR_MS=604800000
CACHE_STALE_LISTING_MS=604800000
CACHE_DIRECTORY_REFRESH_IST=08:00
CACHE_LISTING_REFRESH_IST=10:00
CACHE_LISTING_FOLLOW_UP_IST=11:00,15:45
CACHE_LOCK_MS=10000
CACHE_WAIT_MS=1000
CACHE_MISS_STORM_LIMIT=20
CACHE_MISS_STORM_WINDOW_MS=10000

# Backend market-data provider. Leave unset until catalogue synchronization should run.
# ipo-guru selects the IPO Guru Pro v2 adapter. Upstream calls run only when IPOGURU_ENABLED=true.
# mock is a synthetic fixture provider for development and tests. Production rejects it.
# A fallback is used only when the primary provider times out or is unavailable.
# IPO_DATA_PROVIDER=ipo-guru
# IPO_DATA_FALLBACK_PROVIDER=
IPO_DATA_TIMEOUT_MS=8000

# IPO Guru Pro API v2 client. Disabled by default.
# IPOGURU_ENABLED=true allows GET /me on the protected account route. The worker then calls GET /ipos, GET /gmp, GMP history, subscription, subscription history, and GET /ipos/{slug}.
# Set the key in the API process environment. Never use a NEXT_PUBLIC_ variable.
# The base URL must stay https://www.ipoguru.in/api/v2.
# Minute and day budgets must match the purchased plan before IPOGURU_ENABLED=true.
# IPOGURU_ENABLED=false
# IPOGURU_BASE_URL=https://www.ipoguru.in/api/v2
# IPOGURU_API_KEY=
# IPOGURU_MINUTE_BUDGET=
# IPOGURU_DAILY_BUDGET=
# Public pages keep showing stored IPO Guru data while this is true. Set false when the subscription ends.
# IPOGURU_DISPLAY=true

# Application quota for a future upstream client. These are not vendor limits.
# Reserved requests stay available for an explicit priority caller.
PROVIDER_REQUESTS_PER_MINUTE=30
PROVIDER_REQUESTS_PER_DAY=1000
PROVIDER_RESERVED_REQUESTS=50
PROVIDER_MAX_RETRIES=2
PROVIDER_BACKOFF_BASE_MS=200
PROVIDER_BACKOFF_MAX_MS=5000
PROVIDER_CIRCUIT_FAILURES=5
PROVIDER_CIRCUIT_OPEN_MS=30000

# Background synchronization runs in a separate worker process.
# Start it with npm run start:worker. Do not rely on website visits.
# The API process stays at jobs: not_configured because it does not run the worker.
# Leave IPO_DATA_PROVIDER unset to keep the worker idle.
# ipo-guru with IPOGURU_ENABLED=true refreshes the catalogue, one GMP collection, history, subscription, and one detail document per due issue.
# Current GMP is one GET /gmp. Per-IPO GMP, subscription, financial, and history stay off.
# mock is allowed for development only. Production rejects it.
# A one-shot development sync is npm run sync:once. Production refuses SYNC_MODE=once.
# SYNC_TOKEN is required for that command. Use 16 to 128 characters and do not commit a real token.
# SYNC_TOKEN=
# Schedules are application choices, not a provider's update frequency.
# Open issues use the shortest interval. Upcoming issues wait longer. Listed issues wait the longest.
# One tick makes at most SYNC_MAX_CALLS_PER_TICK provider calls.
# Set REDIS_URL so worker instances share locks and quotas.
# Production workers require REDIS_URL. Without it, locks fail closed (jobs skip) instead of granting unsafe multi-host locks.
# Single-process local development may set SYNC_ALLOW_PROCESS_LOCAL_LOCK=true (refused when NODE_ENV=production).
# SYNC_ALLOW_PROCESS_LOCAL_LOCK=false
SYNC_CATALOG_MS=86400000
# One GET /gmp for open and upcoming issues. Allowed range is 60 to 120 minutes. Default is 90.
# A tight day budget uses 120 minutes. A stale or missing premium uses 60 minutes while budget remains.
# This is not a claim that IPO Guru updates every 15 minutes.
SYNC_GMP_COLLECTION_MS=5400000
SYNC_GMP_OPEN_MS=1800000
SYNC_GMP_UPCOMING_MS=21600000
SYNC_GMP_LISTED_MS=86400000
SYNC_GMP_OTHER_MS=7200000
# Active bidding starts at 60 minutes. Upcoming stays at 6 hours. Listed, closed, and allotment stay at 24 hours.
# IPO Guru says subscription follows exchange releases and a 5–15 minute cache is enough.
# Fifteen minutes is about 96 calls a day per open issue and does not fit a 1,000/day Standard budget.
# Sixty minutes is 24 calls a day per open issue. This is not a claim that the exchange updates hourly.
SYNC_SUBSCRIPTION_OPEN_MS=3600000
SYNC_SUBSCRIPTION_UPCOMING_MS=21600000
SYNC_SUBSCRIPTION_LISTED_MS=86400000
SYNC_SUBSCRIPTION_OTHER_MS=86400000
SYNC_FINANCIAL_OPEN_MS=86400000
SYNC_FINANCIAL_UPCOMING_MS=604800000
SYNC_FINANCIAL_LISTED_MS=604800000
SYNC_FINANCIAL_OTHER_MS=604800000
SYNC_HISTORY_OPEN_MS=21600000
SYNC_HISTORY_UPCOMING_MS=86400000
SYNC_HISTORY_LISTED_MS=604800000
SYNC_HISTORY_OTHER_MS=86400000
SYNC_LOCK_MS=60000
SYNC_MAX_CALLS_PER_TICK=8
SYNC_TICK_MS=60000

# In-app alert evaluation. These values do not call a data provider.
# ALERT_GMP_CHANGE_RUPEES is the absolute rupee move between two fresh readings.
ALERT_GMP_CHANGE_RUPEES=10
ALERT_BATCH_SIZE=40
ALERT_MAX_ATTEMPTS=3
ALERT_LOCK_MS=60000
# Max non-critical Mainboard global pushes per owner per IST day before digesting (default 3).
# ALERT_MAINBOARD_MAX_NONCRITICAL_PER_DAY=3
# Optional IST hour for the about-1-hour close reminder.
# Stored IPO dates do not include a close time. Leave this unset to skip that reminder.
# 17 sends during the 16:00 hour IST on the stored close date.
# ALERT_IPO_CLOSE_HOUR_IST=17

# Optional Expo access token for the push worker. Leave unset until Expo credentials exist.
# EXPO_PUSH_ACCESS_TOKEN=

# Expo push send + receipt polling. Keep false until physical-device delivery is verified.
# Even with a token configured, the worker will not call Expo while this is unset/false.
# PUSH_DELIVERY_ENABLED=false

# Allotment verification against official registrar portals.
# Leave ALLOTMENT_VERIFY_ENABLED unset/false so the recurring worker does not poll registrars.
# ALLOTMENT_VERIFY_ENABLED=false
# One-shot verification pass (allotment-only is allowed even when IPO Guru is unset).
# ALLOTMENT_VERIFY_MODE=once
# Queue confirmed Allotment Out notifications (Prompt 76A board policy):
#   Mainboard → opted-in devices (no watchlist)
#   SME → watchlisted that IPO only
# Enabling this cannot bypass SME watchlist rules. Keep false until explicitly authorized.
# Staging must leave this false. Requires PUSH_DELIVERY_ENABLED=true before Expo will send.
# ALLOTMENT_BROADCAST_ENABLED=false
# Never use a temporary Cloudflare Tunnel URL as the production or preview API origin.

# Days to keep licensed provider observations and usage logs.
GMP_RETENTION_DAYS=400
SUBSCRIPTION_RETENTION_DAYS=400
SYNC_HISTORY_RETENTION_DAYS=90
PROVIDER_USAGE_RETENTION_DAYS=90
