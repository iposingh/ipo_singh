{
  "name": "@ipo-singh/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node ./scripts/ensure-cli-resolution.cjs && expo start",
    "android": "node ./scripts/ensure-cli-resolution.cjs && expo start --android",
    "ios": "node ./scripts/ensure-cli-resolution.cjs && expo start --ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/api/*.test.ts src/theme/*.test.ts src/design/*.test.ts src/catalogue/*.test.ts src/detail/*.test.ts src/charts/*.test.ts src/discovery/*.test.ts src/auth/*.test.ts src/watchlist/*.test.ts src/account/*.test.ts src/notifications/*.test.ts src/promotions/*.test.ts src/settings/*.test.ts src/content/*.test.ts src/network/*.test.ts src/security/*.test.ts src/preview/*.test.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@ipo-singh/contracts": "0.1.0",
    "@ipo-singh/core": "0.1.0",
    "@ipo-singh/design-tokens": "0.1.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~58.0.22",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.0",
    "expo-device": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.20",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gifted-charts": "1.4.81",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  }
}
