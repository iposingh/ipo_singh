# Public IPO Singh API origin. Never set this to IPO Guru.
# Never bundle IPO Guru credentials, MongoDB URIs, admin tokens, or provider secrets.
#
# === development ===
# iOS Simulator may omit this. The app then uses http://127.0.0.1:4000 on this computer only.
#
# Android Emulator often cannot reach the host via 127.0.0.1. Prefer:
# EXPO_PUBLIC_IPO_SINGH_API_ORIGIN=http://10.0.2.2:4000
#
# A physical phone or tablet cannot use localhost / 127.0.0.1 / 10.0.2.2.
# Set this to the development machine's LAN address, for example:
# EXPO_PUBLIC_IPO_SINGH_API_ORIGIN=http://192.168.1.20:4000
#
# A temporary Cloudflare quick tunnel is allowed only for local physical-device smoke tests
# while EXPO_PUBLIC_APP_ENV=development. Do not put trycloudflare hosts into EAS preview/production.
#
# === preview (staging HTTPS) ===
# EXPO_PUBLIC_APP_ENV=preview
# EXPO_PUBLIC_IPO_SINGH_API_ORIGIN=https://api-staging.example.com
#
# === production ===
# EXPO_PUBLIC_APP_ENV=production
# EXPO_PUBLIC_IPO_SINGH_API_ORIGIN=https://api.example.com
#
# Preview and production refuse http, loopback, IPO Guru hosts, and ephemeral tunnels.
EXPO_PUBLIC_IPO_SINGH_API_ORIGIN=

# Public IPO Singh website. Share uses https://example/ipos/<slug>. Never set this to IPO Guru.
# Leave it unset until the public site origin exists. Do not use the API origin here.
EXPO_PUBLIC_IPO_SINGH_SITE_URL=

# development, preview, or production. An unknown value is treated as production outside __DEV__.
EXPO_PUBLIC_APP_ENV=development

# Optional Expo EAS project id for remote push reminders and EAS Update.
# Leave unset until `eas init` has produced a project id. Never invent an id.
# EXPO_PUBLIC_EAS_PROJECT_ID=
