# Public site origin used for canonical URLs, the sitemap, and structured data.
# Set this to the deployed https origin before a production build. No path or credentials.
# Production refuses loopback and temporary tunnel hosts (for example *.trycloudflare.com).
IPO_SINGH_SITE_URL=

# IPO Singh API. The website does not call IPO Guru.
# Local development may use http://127.0.0.1:4000.
# Production requires an explicit https IPO Singh API origin (never a Cloudflare quick tunnel).
IPO_SINGH_API_ORIGIN=http://127.0.0.1:4000

# Optional shared secret matching apps/api INTERNAL_SERVICE_TOKEN.
# Server-side SSR and /api/admin BFF send it as x-ipo-singh-internal so one website host
# is not rate-limited as a single abusive client. Never use NEXT_PUBLIC_*.
# IPO_SINGH_INTERNAL_SERVICE_TOKEN=

# Optional published store pages. Leave empty until the apps are listed. Do not invent URLs.
IPO_SINGH_PLAY_STORE_URL=
IPO_SINGH_APP_STORE_URL=
